{
  "name": "pos",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "electron-dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "next build && node scripts/prepare-next-standalone.cjs && electron-builder",
    "electron-dist": "next build && node scripts/prepare-next-standalone.cjs && electron-builder --win"
  },
  "build": {
    "appId": "com.pos.desktop",
    "productName": "POS",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "!.next/standalone/dist/**/*",
      "!dist/**/*",
      ".env"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      ".next/standalone/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS"
    }
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "firebase": "^11.10.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^0.427.0",
    "next": "^16.0.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-use": "^17.6.1",
    "rxdb": "^17.4.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.8",
    "postcss": "^8",
    "tailwindcss": "^4",
    "ts-prune": "^0.10.3",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
